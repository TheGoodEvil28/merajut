<%- include('header') %>
<section class="section stack">
<header class="page-heading"><h1>Pengelolaan platform</h1><% if (intakeEnabled) { %><a class="button secondary" href="/workspace/intake">Triase percakapan</a><% } %></header>
<% if (saved) { %><p class="notice" role="status">Perubahan tercatat.</p><% } %>
<div class="split"><div class="stack">
<section class="card"><h2>Usaha penjahit</h2>
<% if (!shops.length) { %><p>Undang penjahit pertama untuk membuka katalog.</p><% } %>
<% for (const b of shops) { %>
<details class="ops-entry"><summary><strong><%= b.name %></strong> · <%= b.published?'Dipublikasikan':b.operator?'Menunggu publikasi':b.invited_until?'Menunggu undangan diterima':'Belum ada penjahit' %></summary>
<p><%= b.area %> · <%= b.offers %> layanan aktif</p><p class="preserve"><%= b.description %></p>
<% if (b.operator) { %><p>Penjahit: <%= b.operator %></p>
<form class="stack" action="/api/v1/management/shops/<%= b.id %>" method="post"><input type="hidden" name="revision" value="<%= b.moderation_revision %>">
<label>Tindakan<select name="action"><% if (b.published) { %><option value="hide">Sembunyikan profil</option><% } else if (b.offers) { %><option value="publish">Publikasikan profil</option><% } %><option value="revoke">Cabut akses dan sembunyikan usaha</option></select></label>
<label>Alasan perubahan<textarea name="reason" required minlength="5" maxlength="500"></textarea></label><%- include('reauth') %><button>Simpan keputusan</button></form>
<% } else { %><% if (b.invited_until) { %><p>Undangan berlaku hingga <%= dateTime(b.invited_until) %>.</p><% } %>
<form class="stack" method="post" action="/api/v1/management/invites"><input type="hidden" name="businessId" value="<%= b.id %>"><input type="hidden" name="revision" value="<%= b.moderation_revision %>">
<label>Email penjahit<input type="email" name="email" required maxlength="254"></label><%- include('reauth') %><button>Kirim undangan pengganti</button></form><% } %>
</details><% } %></section>
<section class="card"><h2>Permohonan pembatalan</h2>
<% if (!reviews.length) { %><p>Belum ada pembatalan yang perlu ditinjau.</p><% } %>
<% for (const review of reviews) { %><article class="ops-entry"><h3><%= review.service %> · <%= review.business %></h3>
<p><%= statusLabel(review.status) %> · <%= dateTime(review.requested_at) %></p><p class="preserve"><%= review.reason %></p>
<form class="stack" method="post" action="/api/v1/management/reviews/<%= review.id %>">
<label>Catatan keputusan<textarea name="reason" minlength="5" maxlength="500" required></textarea></label><%- include('reauth') %>
<div class="actions"><button name="action" value="approve">Setujui pembatalan</button><button class="secondary" name="action" value="decline">Tolak pembatalan</button></div>
</form></article><% } %></section>
</div><div class="stack">
<details class="card"><summary>Undang usaha baru</summary><form class="stack" action="/api/v1/management/invites" method="post">
<label>Nama usaha<input name="name" required minlength="3" maxlength="80"></label><label>Area layanan<input name="area" required minlength="3" maxlength="100"></label>
<label>Cerita usaha<textarea name="description" required minlength="10" maxlength="600"></textarea></label>
<label>Email penjahit<input name="email" type="email" required maxlength="254"></label>
<%- include('reauth') %><button>Kirim undangan</button></form></details>
<section class="card"><h2>Kesehatan pengiriman</h2><dl class="terms">
<div><dt>Worker terakhir aktif</dt><dd><%= health.heartbeat ? dateTime(health.heartbeat):'Belum ada kabar' %></dd></div>
<div><dt>Notifikasi dalam proses</dt><dd><%= health.pending %></dd></div>
<div><dt>Pesan masuk gagal</dt><dd><%= health.inbound_failed %></dd></div><div><dt>Email akun gagal</dt><dd><%= health.mail_failed %></dd></div></dl>
<% if (!failures.length) { %><p>Antrean tinjauan notifikasi kosong.</p><% } %>
<% for (const n of failures) { %><details class="ops-entry"><summary><%= n.purpose==='ORDER_READY'?'Siap diambil':'Penawaran' %> · <%= statusLabel(n.state) %></summary>
<p>Simulasi · <%= dateTime(n.updated_at) %> · <%= n.attempts %> percobaan</p>
<form class="stack" action="/api/v1/management/notices/<%= n.id %>" method="post"><label>Alasan tindak lanjut<input name="reason" minlength="5" maxlength="500" required></label>
<%- include('reauth') %><div class="actions"><button name="action" value="retry">Coba lagi</button><button class="secondary" name="action" value="close">Tutup pengiriman</button></div></form></details><% } %></section>
<section class="card timeline"><h2>Riwayat pengelolaan</h2><% if (!events.length) { %><p>Belum ada keputusan tercatat.</p><% } %><ol>
<% for (const e of events) { %><li><strong><%= eventLabel(e.action) %></strong><span><%= e.display_name %> · <%= dateTime(e.created_at) %></span><% if(e.reason) { %><p><%= e.reason %></p><% } %></li><% } %></ol></section>
</div></div></section><%- include('footer') %>
