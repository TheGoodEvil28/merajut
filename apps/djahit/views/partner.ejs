<%- include('header') %>
<section class="section stack">
  <a class="back" href="/pengelola#mitra">Pengelolaan platform</a>
  <header class="page-heading"><h1><%= business?.name ?? 'Tambah mitra' %></h1>
    <% if (business?.published) { %><a href="/penjahit/<%= business.slug %>">Lihat profil publik</a><% } %></header>
  <div class="split"><div class="stack">
    <form class="card stack" method="post" action="/api/v1/management/partners<%= business ? '/'+business.id : '' %>">
      <h2>Profil mitra</h2><input type="hidden" name="_csrf" value="<%= csrf %>">
      <% if (business) { %><input type="hidden" name="revision" value="<%= business.moderation_revision %>"><% } %>
      <label>Nama usaha<input name="name" required minlength="3" maxlength="80" value="<%= business?.name ?? '' %>"></label>
      <label>Area layanan<input name="area" required minlength="3" maxlength="100" value="<%= business?.area ?? '' %>"></label>
      <label>Spesialisasi<input name="specialty" required minlength="2" maxlength="160" value="<%= business?.specialty ?? '' %>"></label>
      <label>Tentang penjahit<textarea name="description" required minlength="10" maxlength="600"><%= business?.description ?? '' %></textarea></label>
      <label>WhatsApp pribadi mitra<input name="whatsapp" type="tel" required maxlength="16" placeholder="628…" value="<%= business?.whatsapp ?? '' %>"></label>
      <p class="muted">Nomor ini hanya terlihat oleh admin.</p>
      <button>Simpan mitra</button>
    </form>
    <% if (business) { %><section class="card stack"><h2>Publikasi marketplace</h2>
      <p><%= business.published ? 'Profil ditampilkan di marketplace.' : 'Profil masih berupa draf.' %></p>
      <% if (business.published || (services.some(s=>s.active) && business.whatsapp)) { %>
      <form class="stack" action="/api/v1/management/shops/<%= business.id %>" method="post">
        <input type="hidden" name="revision" value="<%= business.moderation_revision %>">
        <label>Alasan<textarea name="reason" required minlength="5" maxlength="500"></textarea></label><%- include('reauth') %>
        <button name="action" value="<%= business.published ? 'hide' : 'publish' %>"><%= business.published ? 'Sembunyikan profil' : 'Publikasikan profil' %></button>
      </form><% } else { %><p>Isi nomor WhatsApp dan tambahkan satu layanan aktif untuk memublikasikan profil.</p><% } %>
    </section><% } %>
  </div><% if (business) { const serviceBase='/api/v1/management/partners/'+business.id+'/services'; %><div class="stack">
    <section class="card stack"><h2>Layanan mitra</h2><% for (const service of services) { %>
      <details class="ops-entry"><summary><%= service.name %> · <%= service.active?'Aktif':'Disembunyikan' %></summary>
        <%- include('service-form',{service,serviceBase}) %></details><% } %>
      <details class="ops-entry" <%= services.length?'':'open' %>><summary>Tambah layanan</summary><%- include('service-form',{service:null,serviceBase}) %></details>
    </section>
  </div><% } %></div>
</section>
<%- include('footer') %>
