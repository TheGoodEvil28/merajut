<%- include('header') %>
<% const latest = quotes[0]; const isCustomer=user.role==='customer'; const canManage = user.manager || (user.role === 'provider' && !inquiry.dispatch_state);
const staffBase=user.manager?'/api/v1/management':'/api/v1/provider'; %>
<% const state = order?.status ?? inquiry.status;
const dispatchHint = !order && inquiry.dispatch_state && ['NEW','UNDER_REVIEW'].includes(state) ? ({
  OPEN: canManage ? 'Hubungi mitra melalui WhatsApp dan catat jawabannya.' : 'Admin sedang mencarikan konfirmasi dari mitra pilihan Anda.',
  CONTACTED: 'Admin sedang menunggu jawaban mitra melalui WhatsApp.',
  UNAVAILABLE: 'Mitra berhalangan. Pilih layanan pengganti pada bagian Koordinasi mitra.',
  AVAILABLE: latest?.status==='REJECTED' ? 'Penawaran ditolak. Pilih mitra lain atau tunggu penawaran baru.' : null
})[inquiry.dispatch_state] : null;
const label = step => step==='READY' && order?.handover==='delivery'?'Siap dikirim':statusLabel(step);
const nextStep = dispatchHint || (order ? {
  CONFIRMED: canManage ? 'Mulai pengerjaan saat pesanan siap dikerjakan.' : 'Admin akan memperbarui status saat pengerjaan dimulai.',
  IN_PROGRESS: canManage ? 'Tandai siap diambil setelah pengerjaan selesai.' : 'Penjahit sedang mengerjakan pesanan Anda.',
  READY: canManage ? (inquiry.dispatch_state && order.payment?.state!=='PAID' ? 'Tunggu pembayaran pelanggan dan periksa statusnya sebelum serah terima.' : 'Selesaikan pesanan setelah serah terima.') : (inquiry.dispatch_state ? 'Periksa pembayaran dan serah terima di bawah.' : 'Atur pengambilan sesuai kesepakatan dengan penjahit.'),
  COMPLETED: 'Pengerjaan dan serah terima telah selesai.',
  CANCELLED: 'Pesanan ini telah dibatalkan.'
}[state] : state === 'EXPIRED' || (latest?.status === 'EXPIRED' && state === 'QUOTED')
  ? (canManage ? 'Buat revisi jika Anda masih bisa menerima pekerjaan ini.' : 'Tunggu penawaran baru dari penjahit.')
  : ({
    NEW: canManage ? 'Tinjau detail. Minta klarifikasi jika informasi belum cukup.' : 'Admin akan menghubungi mitra untuk memeriksa ketersediaan.',
    UNDER_REVIEW: canManage ? 'Lengkapi rincian pengerjaan dan kirim penawaran.' : 'Penjahit sedang meninjau permintaan.',
    NEEDS_DETAILS: canManage ? 'Pelanggan perlu mengirim detail tambahan.' : 'Periksa catatan penjahit dan kirim detail tambahan.',
    QUOTED: canManage ? 'Pelanggan perlu memutuskan penawaran terbaru.' : 'Periksa harga, tanggal selesai, dan masa berlaku sebelum menyetujui.',
    DECLINED: 'Penjahit telah menutup permintaan ini.', CANCELLED: 'Permintaan ini telah dibatalkan.'
  })[state]); %>
<section class="section">
  <a class="back" href="<%= user.manager?'/pengelola':'/workspace' %>"><%= user.manager ? 'Papan pesanan' : user.role==='provider' ? 'Ringkasan Usaha' : 'Pesanan Saya' %></a>
  <div class="page-heading">
    <div><p class="location"><%= inquiry.business %></p><h1><%= inquiry.service %></h1></div>
    <span class="status" data-state="<%= state %>"><%= label(latest?.status === 'EXPIRED' && !order && state === 'QUOTED' ? 'EXPIRED' : state) %></span>
  </div>
  <% if (user.role==='provider' && inquiry.dispatch_state) { %><p class="notice">Admin menangani pesanan ini. Berikan kabar pengerjaan melalui WhatsApp.</p><% } %>
  <% if (nextStep && !(user.role==='provider' && inquiry.dispatch_state)) { %><p class="notice"><strong>Langkah berikutnya</strong> · <%= nextStep %>
    <% if (isCustomer && !order && latest?.status === 'SENT' && state === 'QUOTED') { %>
      <a href="#penawaran">Tinjau penawaran v<%= latest.version %></a>
    <% } %></p><% } %>
  <% const progress = ['CONFIRMED', 'IN_PROGRESS', 'READY', 'COMPLETED'];
  if (order && progress.includes(order.status)) { %>
    <ol class="order-progress" aria-label="Tahap pengerjaan">
      <% for (const step of progress) { %>
        <li class="<%= progress.indexOf(step) <= progress.indexOf(order.status) ? 'reached' : '' %>"
          <% if (step === order.status) { %>aria-current="step"<% } %>>
          <span class="step-mark"><% if (progress.indexOf(step) <= progress.indexOf(order.status)) { %><%- include('icon', {name:'check'}) %><% } %></span>
          <%= label(step) %></li>
      <% } %>
    </ol>
  <% } %>
  <div class="split">
    <div class="stack">
      <section class="card">
        <h2>Detail permintaan</h2>
        <p class="preserve"><%= inquiry.description %></p>
        <dl class="terms">
          <% if (inquiry.quantity) { %><div><dt>Jumlah pakaian</dt><dd><%= inquiry.quantity %></dd></div><% } %>
          <% if (inquiry.desired_date) { %><div><dt>Tanggal diminta</dt><dd><%= localDate(inquiry.desired_date) %></dd></div><% } %>
        </dl>
        <% if (inquiry.fit_notes) { %><p class="preserve"><strong>Catatan ukuran</strong><br><%= inquiry.fit_notes %></p><% } %>
      </section>
      <% if (order) { %>
        <section class="card">
          <h2>Detail pesanan</h2>
          <p class="muted">Penawaran v<%= order.quote_version %> disetujui</p>
          <dl class="terms"><div><dt>Harga disepakati</dt><dd><%= money(order.amount) %></dd></div><div><dt>Perkiraan selesai</dt><dd><%= localDate(order.eta) %></dd></div></dl>
          <%- include('quote-breakdown', { items: order.line_items }) %>
          <%- include('logistics',{proposal:order}) %>
          <p class="preserve"><%= order.terms %></p>
          <% const next = { CONFIRMED: ['start', 'Mulai pengerjaan'], IN_PROGRESS: ['ready', order.handover==='delivery'?'Tandai siap dikirim':'Tandai siap diambil'], READY: ['complete', 'Selesaikan pesanan'] }[order.status]; %>
          <% if (canManage && next && !(inquiry.dispatch_state && order.status==='READY' && order.payment?.state!=='PAID')) { %>
            <form method="post" action="<%= staffBase %>/orders/<%= order.id %>/transitions">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <input type="hidden" name="revision" value="<%= order.revision %>">
              <button name="action" value="<%= next[0] %>"><%= next[1] %></button>
            </form>
          <% } %>
          <% if (canManage && order.status === 'CONFIRMED') { %>
            <details class="action-details"><summary>Batalkan pesanan yang diterima</summary>
              <form method="post" action="<%= staffBase %>/orders/<%= order.id %>/transitions" class="stack">
                <input type="hidden" name="_csrf" value="<%= csrf %>">
                <input type="hidden" name="revision" value="<%= order.revision %>">
                <label>Alasan pembatalan<textarea name="detail" maxlength="500" required></textarea></label>
                <button name="action" value="cancel" class="secondary">Batalkan pesanan</button>
              </form>
            </details>
          <% } %>
        </section>
        <% if (inquiry.dispatch_state) { %><%- include('order-payment') %><% } else { %><%- include('order-management', { legacyProvider:user.role==='provider' }) %><% } %>
      <% } %>
      <% if (latest && !order) { %>
        <section class="card" id="penawaran" tabindex="-1">
          <div class="page-heading compact"><h2>Penawaran v<%= latest.version %></h2><span class="status"><%= statusLabel(latest.status) %></span></div>
          <dl class="terms"><div><dt>Harga</dt><dd><%= money(latest.amount) %></dd></div><div><dt>Perkiraan selesai</dt><dd><%= localDate(latest.eta) %></dd></div></dl>
          <%- include('quote-breakdown', { items: latest.line_items }) %>
          <%- include('logistics',{proposal:latest}) %>
          <p class="preserve"><%= latest.terms %></p>
          <p class="muted">Berlaku sampai <%= dateTime(latest.expires_at) %></p>
          <% if (isCustomer && latest.status === 'SENT' && inquiry.status === 'QUOTED') { %>
            <form method="post" action="/api/v1/quotes/<%= latest.id %>/decisions" class="actions">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <input type="hidden" name="version" value="<%= latest.version %>">
              <button name="decision" value="ACCEPTED">Setujui penawaran v<%= latest.version %></button>
              <button name="decision" value="REJECTED" class="secondary">Tolak penawaran</button>
            </form>
            <details class="action-details"><summary>Tanyakan rincian penawaran</summary>
              <form class="stack" method="post" action="/api/v1/inquiries/<%= inquiry.id %>/actions">
                <input type="hidden" name="_csrf" value="<%= csrf %>">
                <input type="hidden" name="revision" value="<%= inquiry.revision %>">
                <label>Pertanyaan untuk penjahit<textarea name="detail" maxlength="500" required></textarea></label>
                <p class="muted">Penjahit perlu mengirimkan penawaran baru setelah menjawab pertanyaan ini.</p>
                <button class="secondary" name="action" value="question">Kirim pertanyaan</button>
              </form>
            </details>
          <% } %>
        </section>
      <% } %>
      <% if (quotes.length > 1) { %>
        <details class="card"><summary>Versi sebelumnya</summary>
          <ul class="quote-history"><% for (const quote of quotes.slice(1)) { %>
            <li><strong>v<%= quote.version %> · <%= money(quote.amount) %> · <%= statusLabel(quote.status) %></strong>
              <%- include('quote-breakdown', { items: quote.line_items }) %></li>
          <% } %></ul>
        </details>
      <% } %>
      <%- include('inquiry-photos') %>
      <% if (canManage && (!inquiry.dispatch_state || inquiry.dispatch_state==='AVAILABLE') && ['NEW', 'UNDER_REVIEW', 'QUOTED','EXPIRED'].includes(inquiry.status)) { %>
        <section class="card">
          <h2><%= latest ? 'Buat revisi penawaran' : 'Buat penawaran' %></h2>
          <% if (quoteError) { %><p class="notice error-message" role="alert"><%= quoteError %></p><% } %>
          <form class="stack" data-quote-editor action="<%= staffBase %>/inquiries/<%= inquiry.id %>/quotes" method="post">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <input type="hidden" name="revision" value="<%= inquiry.revision %>">
            <% const rows = quoteDraft?.items?.length ? quoteDraft.items.slice(0, 8) : latest?.line_items ?? [{
              name: inquiry.service, quantity: latest ? 1 : inquiry.quantity ?? 1, unitPrice: latest?.amount
            }]; %>
            <fieldset class="price-editor">
              <legend>Rincian harga</legend>
              <div data-quote-lines><% for (const [index, item] of rows.entries()) { %>
                <%- include('quote-line', { item, index: index + 1, first: index === 0 }) %>
              <% } %></div>
              <template><%- include('quote-line', { item: {}, index: 2, first: false }) %></template>
              <button type="button" class="secondary" data-add-line hidden>Tambah rincian</button>
              <div class="price-total"><span>Total penawaran</span><output aria-live="polite" aria-label="Total penawaran"></output></div>
            </fieldset>
            <div class="field-pair">
              <label>Perkiraan selesai<input type="date" name="eta" value="<%= quoteDraft?.eta ?? latest?.eta ?? '' %>" required></label>
              <label>Masa berlaku (jam)<input type="number" name="validHours" value="<%= quoteDraft?.validHours ?? 48 %>" min="1" max="168" required></label>
            </div>
            <% if (inquiry.dispatch_state) { %>
              <label>Serah terima<select name="handover" required><option value="pickup">Ambil di tempat penjahit</option><option value="delivery" <%= (quoteDraft?.handover ?? latest?.handover)==='delivery'?'selected':'' %>>Kirim ke pelanggan</option></select></label>
              <label>Jadwal fitting (WIB, opsional)<input type="datetime-local" name="fittingAt" value="<%= quoteDraft?.fittingAt ?? (latest?.fitting_at ? new Date(+new Date(latest.fitting_at)+7*3600000).toISOString().slice(0,16) : '') %>"></label>
              <label>Lokasi fitting<textarea name="fittingPlace" maxlength="200"><%= quoteDraft?.fittingPlace ?? latest?.fitting_place ?? '' %></textarea></label>
            <% } %>
            <label>Rincian pengerjaan dan pengambilan<textarea name="terms" minlength="5" maxlength="1000" rows="3" required><%= quoteDraft?.terms ?? latest?.terms ?? '' %></textarea></label>
            <button>Kirim penawaran</button>
          </form>
        </section>
      <% } %>
      <% const active = ['NEW', 'NEEDS_DETAILS', 'UNDER_REVIEW', 'QUOTED','EXPIRED'].includes(inquiry.status); %>
      <% if (active && (isCustomer || canManage)) { %>
        <details class="card" <%= inquiry.status === 'NEEDS_DETAILS' && !canManage ? 'open' : '' %>>
          <summary>Klarifikasi atau tutup permintaan</summary>
          <form class="stack" action="/api/v1/inquiries/<%= inquiry.id %>/actions" method="post">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <input type="hidden" name="revision" value="<%= inquiry.revision %>">
            <label>Catatan untuk pelanggan dan penjahit<textarea name="detail" rows="3" maxlength="500"></textarea></label>
            <div class="actions">
              <% if (canManage) { %>
                <% if (['NEW','EXPIRED'].includes(inquiry.status)) { %><button name="action" value="review" class="secondary">Mulai tinjau</button><% } %>
                <% if (['NEW', 'UNDER_REVIEW'].includes(inquiry.status)) { %><button name="action" value="clarify" class="secondary">Minta klarifikasi</button><% } %>
                <button name="action" value="decline" class="secondary">Tolak permintaan</button>
              <% } else { %>
                <% if (inquiry.status === 'NEEDS_DETAILS') { %><button name="action" value="respond">Kirim detail</button><% } %>
                <button name="action" value="cancel" class="secondary">Batalkan permintaan</button>
              <% } %>
            </div>
          </form>
        </details>
      <% } %>
    </div>
    <div class="stack">
    <% if (inquiry.dispatch_state) { %><%- include('dispatch-panel') %><% } %>
    <% if (conversation) { %>
      <section class="card timeline">
        <h2>Percakapan terkait</h2>
        <p class="muted">WhatsApp · simulasi</p>
        <% if (conversation.messages.length) { %><ol><% for (const message of conversation.messages) { %>
          <li><strong><%= message.direction === 'INBOUND' ? 'Pelanggan' : 'Balasan penjahit' %></strong>
            <time><%= dateTime(message.created_at) %></time><p class="preserve"><%= message.body %></p></li>
        <% } %></ol><% } %>
        <% if (intakeEnabled && (!canManage || ['AWAITING_HUMAN', 'HUMAN'].includes(conversation.state))) { %>
          <a href="/workspace/intake/<%= conversation.id %>">Buka percakapan</a>
        <% } %>
      </section>
    <% } %>
    <section class="card timeline">
      <h2>Riwayat aktivitas</h2>
      <ol>
        <% for (const item of events) { %>
          <li><strong><%= eventLabel(item.kind) %></strong>
            <span><%= statusLabel(item.new_status) %> · <%= item.actor %></span>
            <time datetime="<%= item.created_at.toISOString() %>"><%= dateTime(item.created_at) %></time>
            <% if (item.detail) { %><p class="preserve"><%= item.detail %></p><% } %>
          </li>
        <% } %>
      </ol>
    </section>
    </div>
  </div>
</section>
<%- include('footer') %>
