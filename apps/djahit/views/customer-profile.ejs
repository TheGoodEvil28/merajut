<%- include('header') %>
<section class="narrow section">
  <a class="back" href="/workspace">Pesanan Saya</a>
  <h1>Profil saya</h1>
  <% if (saved) { %><p class="notice" role="status">Profil tersimpan.</p><% } %>
  <form class="card stack" action="/akun/profil" method="post">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label>Nama pelanggan<input name="name" minlength="2" maxlength="80" autocomplete="name" value="<%= profile.display_name %>" required></label>
    <div><strong>Email terverifikasi</strong><p><%= profile.email %></p></div>
    <label>Nomor WhatsApp<input name="phone" type="tel" autocomplete="tel" maxlength="16" value="<%= profile.phone ?? '' %>"></label>
    <label>Alamat pengiriman<textarea name="address" maxlength="400" autocomplete="street-address"><%= profile.address ?? '' %></textarea></label>
    <p class="muted">Admin menggunakan kontak ini untuk koordinasi fitting dan serah terima.</p>
    <button>Simpan profil</button>
  </form>
</section>
<%- include('footer') %>
