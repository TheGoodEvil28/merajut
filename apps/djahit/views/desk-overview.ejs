<section class="card" aria-labelledby="queue-title">
  <div class="page-heading compact"><h2 id="queue-title">Papan pesanan</h2><span>Halaman <%= page %></span></div>
  <nav class="category-tabs" aria-label="Filter pesanan"><% for (const [key,label] of Object.entries(deskFilters)) { %>
    <a href="?filter=<%= key %>#queue-title" <%= key===filter?'aria-current=true':'' %>><%= label %></a><% } %></nav>
  <% if (!queue.length) { %><p>Belum ada permintaan pada halaman ini.</p><% } %>
  <ul class="record-list"><% for (const item of queue) { %>
    <li><a href="/requests/<%= item.id %>"><span class="order-record"><strong><%= item.service %></strong>
      <small><%= item.customer %> · <%= item.business %> · <%= dateTime(item.created_at) %></small></span>
      <span class="order-action"><span class="status"><%= item.complaint_open?'Keluhan terbuka':statusLabel((item.order_status==='COMPLETED' ? item.order_status : item.payment_state) || item.order_status || (item.status==='NEW' || item.status==='UNDER_REVIEW' ? item.dispatch_state || item.status : item.status)) %></span>
      <span class="record-cta">Buka pesanan →</span></span></a></li><% } %></ul>
  <nav class="actions" aria-label="Halaman papan pesanan"><% if (page>1) { %><a href="?filter=<%= filter %>&amp;page=<%= page-1 %>">Sebelumnya</a><% } %>
    <% if (nextPage) { %><a href="?filter=<%= filter %>&amp;page=<%= page+1 %>">Berikutnya</a><% } %></nav>
</section>
<section id="kinerja" class="card"><h2>Kinerja layanan</h2>
  <div class="desk-table"><table><caption>Seluruh periode · nilai dari pembayaran terverifikasi</caption>
    <thead><tr><th scope="col">Layanan dan mitra</th><th scope="col">Permintaan</th><th scope="col">Diterima</th><th scope="col">Selesai</th><th scope="col">Bagian mitra</th><th scope="col">Komisi platform</th><th scope="col">Komisi uji</th></tr></thead>
    <tbody><% for (const b of performance) { %><tr><th scope="row"><%= b.service %><br><small><%= b.name %></small></th><td><%= b.requests %></td><td><%= b.accepted %></td><td><%= b.completed %></td><td><%= money(b.partner_net) %></td><td><%= money(b.revenue) %></td><td><%= money(b.test_revenue) %></td></tr><% } %></tbody>
  </table></div>
</section>
