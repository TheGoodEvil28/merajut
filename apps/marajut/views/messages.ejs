<%- include('header') %>
<section class="narrow section">
  <a class="back" href="/workspace">Pesanan Saya</a>
  <h1>Notifikasi simulasi</h1>
  <p class="notice"><%= mode === 'simulated'
    ? 'Kotak masuk simulasi untuk notifikasi penawaran dan jahitan siap.'
    : 'Simulasi sedang dinonaktifkan. Daftar ini berisi catatan simulasi sebelumnya.' %></p>
  <% if (mode === 'simulated') { %>
    <form class="actions" method="post" action="/api/v1/messages/preference">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <button name="enabled" value="<%= !enabled %>" class="secondary"><%= enabled ? 'Nonaktifkan notifikasi simulasi' : 'Aktifkan notifikasi simulasi' %></button>
      <a href="/workspace/messages">Muat ulang notifikasi</a>
    </form>
  <% } %>
  <% if (!messages.length) { %><p class="muted">Belum ada notifikasi.</p><% } %>
  <ul class="record-list">
    <% for (const message of messages) { %>
      <li><a href="/requests/<%= message.inquiry_id %>"><strong><%= message.purpose === 'QUOTE_READY' ? 'Penawaran tersedia' : message.managed ? 'Jahitan siap dibayar' : 'Pesanan siap diambil' %></strong>
        <span><%= dateTime(message.updated_at) %></span></a>
        <span class="status"><%= statusLabel(message.state) %></span></li>
    <% } %>
  </ul>
</section>
<%- include('footer') %>
