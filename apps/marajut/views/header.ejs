<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#512746">
  <title><%= title %> · Marajut</title>
  <link rel="icon" type="image/svg+xml" href="/assets/marajut-mark.svg">
  <link rel="preload" href="/assets/fonts/dm-sans.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/style.css">
  <script src="/assets/forms.js" defer></script>
</head>
<% const here = typeof currentPath === 'string' ? currentPath : '';
const admin = Boolean(user?.manager && (here.startsWith('/pengelola') || here.startsWith('/requests/') || here.startsWith('/api/')));
const studio = admin || (user?.role==='provider' && here!=='/' && !here.startsWith('/penjahit/'));
const links = user?.role === 'provider' ? [
  ['/workspace', 'Ringkasan', 'grid', here === '/workspace' || here.startsWith('/requests/')],
  ['/workspace/services', 'Layanan Saya', 'scissors', here === '/workspace/services'],
  ['/workspace/profile', 'Profil Usaha', 'shop', here === '/workspace/profile'],
  ...(intakeEnabled ? [['/workspace/intake', 'Chat simulasi', 'chat', here.startsWith('/workspace/intake')]] : [])
] : user?.role === 'operator' ? [
  ...(user.manager ? [
    ['/pengelola','Pesanan','bag',here==='/pengelola' || here.startsWith('/requests/')],
    ['/pengelola/mitra','Mitra','shop',here.startsWith('/pengelola/mitra')],
    ['/pengelola/kinerja','Kinerja','grid',here==='/pengelola/kinerja'],
    ['/pengelola/operasional','Operasional','inbox',here==='/pengelola/operasional']
  ] : intakeEnabled ? [['/workspace/intake','Chat simulasi','chat',here.startsWith('/workspace/intake')]] : [])
] : [
  ['/#services', 'Cari Penjahit', 'search', here === '/' || here.startsWith('/penjahit/')],
  ...(user ? [
    ['/workspace', 'Pesanan Saya', 'bag', here === '/workspace' || here.startsWith('/requests/')],
    ['/akun/profil', 'Profil saya', 'shop', here === '/akun/profil']
  ] : [['/#cara-kerja', 'Cara kerja', 'quote', false], ['/pengelola', 'Admin', 'shop', false]])
]; %>
<body class="<%= studio ? 'studio-shell'+(admin?' admin-shell':'') : 'market-shell' %>">
  <a class="skip" href="#main">Lewati ke konten</a>
  <header class="site-header">
    <div class="wrap nav">
      <a class="brand" href="<%= admin ? '/pengelola' : user?.role === 'provider' ? '/workspace' : '/' %>" aria-label="Beranda Marajut"><img src="/assets/marajut-mark.svg" alt="" width="36" height="36">Marajut</a>
      <% if (studio) { %><span class="rail-label"><%= admin?'Ruang admin':'Ruang usaha' %></span><% } %>
      <nav aria-label="Navigasi utama">
        <% for (const [url, label, icon, current] of links) { %>
          <a href="<%= url %>" <% if (current) { %>aria-current="page"<% } %>><%- include('icon', {name:icon}) %><span><%= label %></span></a>
        <% } %>
      </nav>
      <div class="nav-account">
      <% if (user) { %>
        <% if (studio) { %><span class="account-name"><b aria-hidden="true"><%= Array.from(user.display_name)[0] %></b><%= user.display_name %></span><% } %>
        <form action="/api/v1/session/logout" method="post">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="quiet"><%- include('icon', {name:'door'}) %>Keluar</button>
        </form>
      <% } else { %><a class="button" href="/login">Masuk <%- include('icon', {name:'arrow'}) %></a><% } %>
      </div>
    </div>
  </header>
  <main class="wrap" id="main" tabindex="-1">
