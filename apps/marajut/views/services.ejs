<%- include('header') %>
<section class="section">
  <div class="page-heading"><h1>Layanan Saya</h1>
    <% if (business.published) { %><a class="button secondary" href="/penjahit/<%= business.slug %>">Lihat profil publik</a><% } %></div>
  <p class="muted"><%= services.filter(service => service.active).length %> ditampilkan ·
    <%= services.filter(service => !service.active).length %> disembunyikan</p>
  <% if (!business.published) { %><p class="notice">Profil usaha belum dipublikasikan oleh pengelola Marajut.</p><% } %>
  <div class="split">
    <div class="stack">
      <% for (const service of services) { %>
        <details class="card service-setting"><summary>
          <span class="setting-top"><strong><%= service.name %></strong><span class="status" data-state="<%= service.active ? 'VISIBLE' : 'HIDDEN' %>"><%= service.active ? 'Ditampilkan' : 'Disembunyikan' %></span></span>
          <span class="setting-info"><%= serviceCategories[service.category] %> · <%= service.price_hint ? 'Mulai dari ' + money(service.price_hint) : 'Harga sesuai penawaran' %><% if (service.lead_days) { %> · ± <%= service.lead_days %> hari<% } %></span>
          <span class="setting-edit">Ubah layanan</span>
        </summary>
          <%- include('service-form', { service }) %>
        </details>
      <% } %>
      <% if (!services.length) { %><p class="notice">Belum ada layanan. Tambahkan layanan agar pelanggan tahu apa yang dapat Anda kerjakan.</p><% } %>
    </div>
    <section class="card">
      <h2>Tambah layanan</h2>
      <%- include('service-form', { service: null }) %>
    </section>
  </div>
</section>
<%- include('footer') %>
