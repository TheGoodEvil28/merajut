<section class="card quote-review" id="penawaran" tabindex="-1">
  <div class="section-caption">
    <div><h2>Penawaran harga</h2><p class="muted"><%= inquiry.business %> · Versi <%= latest.version %></p></div>
    <span class="status" data-state="<%= latest.status %>"><%= statusLabel(latest.status) %></span>
  </div>
  <div class="price-highlight">
    <span>Total penawaran</span><strong><%= money(latest.amount) %></strong>
  </div>
  <%- include('quote-breakdown',{items:latest.line_items}) %>
  <dl class="terms"><div><dt>Perkiraan selesai</dt><dd><%= localDate(latest.eta) %></dd></div>
    <% if (latest.status==='SENT') { %><div><dt>Berlaku sampai</dt><dd><%= dateTime(latest.expires_at) %></dd></div><% } %>
  </dl>
  <%- include('logistics',{proposal:latest}) %>
  <p class="preserve"><%= latest.terms %></p>
  <% if (quoteReviewUrl) { %>
    <div class="form-disclosure">
      <p>Teruskan tautan ini agar pelanggan bisa masuk dan meninjau penawaran.</p>
      <p class="preserve muted" id="quote-share-link"><%= quoteReviewUrl %></p>
      <div class="actions">
        <button type="button" class="secondary" data-copy="quote-share-link" data-copy-label="Tautan" hidden>Salin tautan penawaran</button>
        <span class="muted" data-copy-status role="status"></span>
      </div>
    </div>
  <% } %>
  <% if (isCustomer && journey.key==='QUOTED') { %>
    <p class="form-help muted">Dengan menyetujui penawaran, Anda memesan sesuai rincian di atas. Pembayaran dilakukan saat jahitan siap.</p>
    <form method="post" action="/api/v1/quotes/<%= latest.id %>/decisions">
      <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="version" value="<%= latest.version %>">
      <button name="decision" value="ACCEPTED" data-confirm="Penawaran menjadi pesanan dengan harga dan jadwal ini." data-confirm-title="Setujui penawaran?" data-confirm-action="Ya, setujui" data-confirm-icon="check">Setujui penawaran</button>
    </form>
    <details class="form-disclosure">
      <summary>Minta penyesuaian</summary>
      <form class="stack" method="post" action="/api/v1/inquiries/<%= inquiry.id %>/actions">
        <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="revision" value="<%= inquiry.revision %>">
        <label><span class="field-label">Pesan untuk admin<span class="req" aria-hidden="true"></span></span><textarea name="detail" rows="3" maxlength="500" required></textarea></label>
        <p class="form-help muted">Admin akan menindaklanjuti permintaan Anda dan mengirim versi penawaran baru.</p>
        <button class="secondary" name="action" value="question">Kirim permintaan penyesuaian</button>
      </form>
    </details>
    <details class="form-disclosure">
      <summary>Tolak penawaran</summary>
      <p>Anda dapat memilih penjahit lain atau menunggu penawaran baru setelah menolak.</p>
      <form method="post" action="/api/v1/quotes/<%= latest.id %>/decisions">
        <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="version" value="<%= latest.version %>">
        <button class="secondary" name="decision" value="REJECTED" data-confirm="Penjahit akan diberi tahu bahwa penawaran ini ditolak." data-confirm-title="Tolak penawaran?" data-confirm-action="Ya, tolak" data-confirm-icon="cancel" data-confirm-tone="danger">Tolak penawaran ini</button>
      </form>
    </details>
  <% } %>
</section>
