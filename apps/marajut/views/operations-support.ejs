<%- include('header') %>
<section class="section admin-page">
  <header class="page-heading admin-heading">
    <div><h1>Operasional</h1><p>Tinjau pembatalan, notifikasi, dan aktivitas pengelolaan.</p></div>
    <% const heartbeatAge = health.heartbeat ? Date.now() - new Date(health.heartbeat).getTime() : Infinity;
       const failedTotal = Number(health.inbound_failed) + Number(health.mail_failed) + failures.length;
       const workerIdle = heartbeatAge > 5 * 60 * 1000;
       const healthTone = failedTotal ? 'bad' : workerIdle ? 'warn' : 'ok';
       const healthLabel = failedTotal ? failedTotal + ' perlu ditinjau' : workerIdle ? 'Worker tidak aktif' : 'Pengiriman normal'; %>
    <div class="actions heading-actions">
      <button type="button" class="secondary health-status" data-tone="<%= healthTone %>" popovertarget="health-panel" aria-haspopup="dialog"><span class="status-dot" aria-hidden="true"></span><%= healthLabel %></button>
      <% if (intakeEnabled) { %><a class="button secondary" href="/workspace/intake">Percakapan simulasi <%- include('icon',{name:'chat'}) %></a><% } %>
    </div>
  </header>
  <div id="health-panel" popover class="health-popover" role="dialog" aria-labelledby="health-title">
    <div class="health-head"><h2 id="health-title">Kesehatan pengiriman</h2><button type="button" class="popover-close" popovertarget="health-panel" popovertargetaction="hide" aria-label="Tutup"></button></div>
    <ul class="health-list">
      <li data-tone="<%= workerIdle ? 'warn' : 'ok' %>"><span class="health-icon" aria-hidden="true"><%- include('icon',{name:'clock'}) %></span><span>Worker terakhir aktif<small><%= health.heartbeat ? dateTime(health.heartbeat) : 'Belum ada kabar' %></small></span></li>
      <li data-tone="<%= Number(health.pending) ? 'info' : 'ok' %>"><span class="health-icon" aria-hidden="true"><%- include('icon',{name:'refresh'}) %></span><span>Notifikasi dalam proses</span><b><%= health.pending %></b></li>
      <li data-tone="<%= Number(health.inbound_failed) ? 'bad' : 'ok' %>"><span class="health-icon" aria-hidden="true"><%- include('icon',{name:'chat'}) %></span><span>Pesan masuk gagal</span><b><%= health.inbound_failed %></b></li>
      <li data-tone="<%= Number(health.mail_failed) ? 'bad' : 'ok' %>"><span class="health-icon" aria-hidden="true"><%- include('icon',{name:'inbox'}) %></span><span>Email akun gagal</span><b><%= health.mail_failed %></b></li>
    </ul>
    <% if (!failures.length) { %><p class="health-empty"><%- include('icon',{name:'check'}) %> Antrean tinjauan notifikasi kosong.</p><% } %>
    <% for (const n of failures) { %><details class="ops-entry"><summary><%= n.purpose==='ORDER_READY'?'Siap diambil':'Penawaran' %> · <%= statusLabel(n.state) %></summary>
<p>Simulasi · <%= dateTime(n.updated_at) %> · <%= n.attempts %> percobaan</p>
<form class="stack" action="/api/v1/management/notices/<%= n.id %>" method="post"><label><span class="field-label">Alasan tindak lanjut<span class="req" aria-hidden="true"></span></span><input name="reason" minlength="5" maxlength="500" required></label>
<%- include('reauth') %><div class="actions"><button name="action" value="retry">Coba lagi</button><button class="secondary" name="action" value="close" data-confirm="Notifikasi ini tidak akan dicoba dikirim lagi." data-confirm-title="Tutup pengiriman notifikasi?" data-confirm-action="Ya, tutup" data-confirm-icon="cancel" data-confirm-tone="danger">Tutup pengiriman</button></div></form></details><% } %>
  </div>
  <% if (saved) { %><p class="save-feedback" role="status">Perubahan tercatat.</p><% } %>
  <div class="split"><div class="stack">
<section class="card"><h2>Permohonan pembatalan</h2>
<% if (!reviews.length) { %><p>Belum ada pembatalan yang perlu ditinjau.</p><% } %>
<% for (const review of reviews) { %><article class="ops-entry"><h3><%= review.service %> · <%= review.business %></h3>
<p><%= statusLabel(review.status) %> · <%= dateTime(review.requested_at) %></p><p class="preserve"><%= review.reason %></p>
<form class="stack" method="post" action="/api/v1/management/reviews/<%= review.id %>">
<label><span class="field-label">Catatan keputusan<span class="req" aria-hidden="true"></span></span><textarea name="reason" minlength="5" maxlength="500" required></textarea></label><%- include('reauth') %>
<div class="actions"><button name="action" value="approve" data-confirm="Pesanan dibatalkan. Tindakan ini tidak bisa diurungkan." data-confirm-title="Setujui pembatalan?" data-confirm-action="Ya, setujui" data-confirm-icon="cancel" data-confirm-tone="danger">Setujui pembatalan</button><button class="secondary" name="action" value="decline" data-confirm="Pesanan tetap berjalan dan pengaju diberi tahu." data-confirm-title="Tolak pembatalan?" data-confirm-action="Ya, tolak" data-confirm-icon="check">Tolak pembatalan</button></div>
</form></article><% } %></section>

    <% const invites=shops.filter(shop=>!shop.operator && !shop.whatsapp); %>
    <% if (invites.length) { %><details class="card workflow-options"><summary>Undangan akun lama</summary>
      <% for (const shop of invites) { %>
        <form class="stack" method="post" action="/api/v1/management/invites">
          <h3><%= shop.name %></h3>
          <% if (shop.invited_until) { %><p>Undangan berlaku sampai <%= dateTime(shop.invited_until) %>.</p><% } %>
          <input type="hidden" name="businessId" value="<%= shop.id %>"><input type="hidden" name="revision" value="<%= shop.moderation_revision %>">
          <label><span class="field-label">Email penjahit<span class="req" aria-hidden="true"></span></span><input type="email" name="email" required maxlength="254"></label>
          <%- include('reauth') %><button>Kirim ulang undangan</button>
        </form>
      <% } %></details><% } %>
  </div><div class="stack">
<section class="card invite-card"><div class="section-caption"><div><h2>Pengguna ruang usaha lama</h2><p class="muted">Buat profil mitra dan kirim undangan masuk ke email penjahit.</p></div>
<button type="button" command="show-modal" commandfor="invite-dialog"><%- include('icon',{name:'plus'}) %>Undang pengguna</button></div></section>
<dialog class="confirm-dialog form-dialog" id="invite-dialog" aria-labelledby="invite-title"><form class="confirm-panel" action="/api/v1/management/invites" method="post">
<span class="confirm-icon" aria-hidden="true"><%- include('icon',{name:'inbox'}) %></span><h2 id="invite-title">Undang penjahit lama</h2>
<p>Profil usaha dibuat sebagai draf, lalu undangan masuk dikirim ke email penjahit.</p>
<label><span class="field-label">Nama usaha<span class="req" aria-hidden="true"></span></span><input name="name" required minlength="3" maxlength="80" autofocus></label><label><span class="field-label">Area layanan<span class="req" aria-hidden="true"></span></span><input name="area" required minlength="3" maxlength="100"></label>
<label><span class="field-label">Cerita usaha<span class="req" aria-hidden="true"></span></span><textarea name="description" required minlength="10" maxlength="600"></textarea></label>
<label><span class="field-label">Email penjahit<span class="req" aria-hidden="true"></span></span><input name="email" type="email" required maxlength="254" autocomplete="off"></label>
<%- include('reauth') %>
<div class="confirm-actions"><button type="button" class="secondary" data-dialog-close>Batal</button><button>Kirim undangan</button></div></form></dialog>
<section class="card timeline"><h2>Riwayat pengelolaan</h2><% if (!events.length) { %><p>Belum ada keputusan tercatat.</p><% } %><ol>
<% for (const e of events) { %><li><strong><%= eventLabel(e.action) %></strong><span><%= e.display_name %> · <%= dateTime(e.created_at) %></span><% if(e.reason) { %><p><%= e.reason %></p><% } %></li><% } %></ol></section>

  </div></div>
</section>
<%- include('footer') %>
