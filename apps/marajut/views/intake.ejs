<%- include('header') %>
<% const labels = {
  AUTOMATED: 'Pengisian otomatis', AWAITING_CUSTOMER: 'Menunggu informasi pelanggan',
  AWAITING_HUMAN: 'Perlu ditangani', HUMAN: 'Sedang ditangani', RESOLVED: 'Percakapan selesai'
}; %>
<section class="section">
  <% const backLink = user.role === 'provider' ? ['/workspace', 'Ringkasan Usaha'] : user.role === 'customer' ? ['/workspace', 'Pesanan Saya'] : user.manager ? ['/pengelola', 'Pesanan'] : null; %>
  <% if (backLink) { %><a class="back" href="<%= backLink[0] %>"><%= backLink[1] %></a><% } %>
  <div class="page-heading">
    <h1><%= user.role === 'customer' ? 'Simulasi WhatsApp' : 'Percakapan WhatsApp' %></h1>
    <a class="button secondary refresh-button" href="/workspace/intake"><%- include('icon', {name:'refresh'}) %>Muat ulang</a>
  </div>
  <p class="notice"><strong>Simulasi WhatsApp.</strong> Pesan hanya muncul di Marajut. <%= user.role === 'customer' ? 'Pilih layanan dan ceritakan kebutuhan Anda. Setelah tersambung, permintaan bisa dilanjutkan ke penawaran di akun Anda.' : 'Buka percakapan yang perlu ditangani, lalu hubungkan dengan permintaan untuk menyiapkan penawaran.' %></p>
  <% if (user.role === 'customer') { %>
    <div class="split">
      <div class="stack">
        <section class="card">
          <h2>Kirim pesan percobaan</h2>
          <form class="stack" method="post" action="/api/v1/intake/events">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <input type="hidden" name="eventId" value="<%= newKey() %>">
            <input type="hidden" name="kind" value="text">
            <label>Pesan pelanggan<textarea name="text" rows="3" maxlength="1500" required></textarea></label>
            <button>Kirim pesan simulasi</button>
          </form>
        </section>
        <% if (sender) { %>
          <section class="card stack">
            <h2>Lengkapi permintaan</h2>
            <form class="stack" method="post" action="/api/v1/intake/events">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <input type="hidden" name="eventId" value="<%= newKey() %>">
              <input type="hidden" name="kind" value="select_service">
              <label>Penjahit dan layanan<select name="serviceId" required>
                <option value="">Pilih layanan</option>
                <% for (const service of services) { %>
                  <option value="<%= service.id %>"><%= service.business %> · <%= service.name %></option>
                <% } %>
              </select></label>
              <button class="secondary">Pilih layanan</button>
            </form>
            <form class="stack" method="post" action="/api/v1/intake/events">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <input type="hidden" name="eventId" value="<%= newKey() %>">
              <input type="hidden" name="kind" value="details">
              <label>Detail jahitan<textarea name="text" rows="3" minlength="10" maxlength="1500" required></textarea></label>
              <div class="field-pair"><label>Jumlah pakaian<input name="quantity" type="number" min="1" max="50" value="1" required></label>
                <label>Tanggal selesai yang diinginkan<input name="desiredDate" type="date"></label></div>
              <label>Catatan ukuran (opsional)<input name="fitNotes" maxlength="500"></label>
              <button class="secondary">Kirim detail</button>
            </form>
            <form method="post" action="/api/v1/intake/events">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <input type="hidden" name="eventId" value="<%= newKey() %>">
              <button name="kind" value="handoff" class="secondary">Minta bantuan penjahit</button>
            </form>
          </section>
        <% } %>
      </div>
      <div class="stack">
        <% if (sender) { %>
          <section class="card">
            <h2>Identitas pengirim</h2>
            <% if (sender.bound) { %><p>Terhubung dengan akun Anda.</p>
              <details><summary>Lepas tautan pengirim</summary><p>Sesi percakapan aktif akan ditutup dan notifikasi simulasi dinonaktifkan.</p>
                <form method="post" action="/api/v1/intake/binding/unlink"><input type="hidden" name="_csrf" value="<%= csrf %>">
                  <input type="hidden" name="senderId" value="<%= sender.id %>"><button class="secondary">Konfirmasi pelepasan</button></form></details>
            <% } else if (challenge?.proved) { %>
              <form method="post" action="/api/v1/intake/binding/confirm">
                <input type="hidden" name="_csrf" value="<%= csrf %>">
                <input type="hidden" name="challengeId" value="<%= challenge.id %>">
                <button>Konfirmasi tautan</button>
              </form>
            <% } else { %>
              <% if (challenge) { %><p>Bukti belum diproses. Muat ulang halaman setelah mengirimnya.</p><% } %>
              <form method="post" action="/api/v1/intake/binding/start">
                <input type="hidden" name="_csrf" value="<%= csrf %>">
                <input type="hidden" name="senderId" value="<%= sender.id %>">
                <button class="secondary"><%= challenge ? 'Buat kode baru' : 'Tautkan pengirim' %></button>
              </form>
            <% } %>
          </section>
        <% } %>
        <section class="card">
          <h2>Percakapan</h2>
          <%- include('intake-list', { labels }) %>
        </section>
        <% if (jobs.length) { %>
          <section class="card">
            <h2>Aktivitas simulasi</h2>
            <ul class="record-list">
              <% for (const job of jobs) { %>
                <li><span><%= {text:'Pesan pelanggan',select_service:'Pilihan layanan',details:'Detail jahitan',handoff:'Bantuan penjahit',binding_proof:'Verifikasi pengirim'}[job.kind] %></span><span class="status"><%= statusLabel(job.state) %></span></li>
              <% } %>
            </ul>
          </section>
        <% } %>
      </div>
    </div>
  <% } else { %>
    <section class="card">
      <h2><%= user.role === 'operator' ? 'Percakapan belum diarahkan' : 'Percakapan untuk usaha Anda' %></h2>
      <%- include('intake-list', { labels }) %>
    </section>
  <% } %>
</section>
<%- include('footer') %>
