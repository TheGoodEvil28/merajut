<%- include('header') %>
<% const activeCount = services.filter(service=>service.active).length; %>
<section class="section admin-page">
  <a class="back" href="/pengelola/mitra">Mitra penjahit</a>
  <header class="page-heading admin-heading">
    <div><h1><%= business?.name ?? 'Tambah mitra' %></h1>
      <p><%= business?.area ?? 'Simpan profil untuk menambahkan layanan penjahit.' %></p></div>
    <% if (business?.published) { %><a class="button secondary" href="/penjahit/<%= business.slug %>">Lihat profil publik <%- include('icon',{name:'external'}) %></a><% } %>
  </header>
  <% if (saved) { %><p class="save-feedback" role="status"><%- include('icon',{name:'check'}) %> Perubahan tercatat.</p><% } %>
  <div class="workflow-layout">
    <div class="stack">
      <form class="card stack" method="post" action="/api/v1/management/partners<%= business?'/'+business.id:'' %>">
        <h2>Profil mitra</h2>
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <% if (business) { %><input type="hidden" name="revision" value="<%= business.moderation_revision %>"><% } %>
        <div class="field-pair">
          <label><span class="field-label">Nama usaha<span class="req" aria-hidden="true"></span></span><input name="name" required minlength="3" maxlength="80" value="<%= business?.name ?? '' %>"></label>
          <label><span class="field-label">Area layanan<span class="req" aria-hidden="true"></span></span><input name="area" required minlength="3" maxlength="100" value="<%= business?.area ?? '' %>"></label>
        </div>
        <label><span class="field-label">Spesialisasi<span class="req" aria-hidden="true"></span></span><input name="specialty" required minlength="2" maxlength="160" value="<%= business?.specialty ?? '' %>"></label>
        <label><span class="field-label">Tentang penjahit<span class="req" aria-hidden="true"></span></span><textarea name="description" required minlength="10" maxlength="600" rows="3"><%= business?.description ?? '' %></textarea></label>
        <label><span class="field-label">WhatsApp pribadi mitra<span class="req" aria-hidden="true"></span></span><input name="whatsapp" type="tel" required maxlength="32" placeholder="0812 3456 7890" value="<%= business?.whatsapp ?? '' %>"></label>
        <p class="muted form-help">Kontak WhatsApp digunakan admin untuk koordinasi pesanan.</p>
        <button>Simpan mitra</button>
      </form>
      <% if (business) { const serviceBase='/api/v1/management/partners/'+business.id+'/services'; %>
        <section class="card stack disclosure-list" id="layanan-mitra"><h2>Layanan mitra</h2>
          <% for (const service of services) { %>
            <details class="form-disclosure"><summary>
              <strong><%= service.name %></strong> <span class="muted">· <%= service.active?'Aktif':'Disembunyikan' %> · <%= service.price_hint?money(service.price_hint):'Sesuai penawaran' %></span>
            </summary><%- include('service-form',{service,serviceBase}) %></details>
          <% } %>
          <details class="form-disclosure" <%= services.length?'':'open' %>><summary>Tambah layanan</summary>
            <%- include('service-form',{service:null,serviceBase}) %>
          </details>
        </section>
      <% } %>
    </div>
    <% if (business) { %><section class="card stack" id="publikasi">
      <div class="section-caption"><h2>Marketplace</h2><span class="status" data-tone="<%= business.published?'complete':'neutral' %>"><%= business.published?'Aktif':'Draf' %></span></div>
      <dl class="summary-list">
        <div><dt>Layanan aktif</dt><dd><%= activeCount %></dd></div>
        <div><dt>Kontak WhatsApp</dt><dd><%= business.whatsapp?'Tersimpan':'Belum diisi' %></dd></div>
        <% if (business.operator) { %><div><dt>Akun penjahit</dt><dd><%= business.operator %></dd></div><% } %>
      </dl>
      <% const canPublish = business.published || (activeCount && (business.whatsapp || business.operator)); %>
      <% if (!canPublish) { %><p>Simpan kontak WhatsApp dan tambahkan layanan aktif untuk memublikasikan profil.</p><% } %>
      <% if (canPublish || business.operator) { %><div class="actions">
        <% if (canPublish) { %><button type="button" class="<%= business.published?'secondary':'' %>" command="show-modal" commandfor="publication-dialog"><%- include('icon',{name:business.published?'eye-off':'eye'}) %><%= business.published?'Sembunyikan profil':'Publikasikan profil' %></button><% } %>
        <% if (business.operator) { %><button type="button" class="secondary danger-outline" command="show-modal" commandfor="revoke-dialog"><%- include('icon',{name:'lock'}) %>Cabut akses</button><% } %>
      </div><% } %>
      <% if (canPublish) { %>
        <dialog class="confirm-dialog form-dialog" id="publication-dialog" aria-labelledby="publication-title">
          <form class="confirm-panel" action="/api/v1/management/shops/<%= business.id %>" method="post">
            <span class="confirm-icon" aria-hidden="true"><%- include('icon',{name:business.published?'eye-off':'eye'}) %></span>
            <h2 id="publication-title"><%= business.published?'Sembunyikan profil?':'Publikasikan profil?' %></h2>
            <p><%= business.published?'Profil dan layanan mitra tidak lagi tampil di marketplace sampai dipublikasikan lagi.':'Profil dan layanan aktif mitra akan tampil di marketplace untuk pelanggan.' %></p>
            <input type="hidden" name="revision" value="<%= business.moderation_revision %>">
            <label><span class="field-label">Alasan perubahan<span class="req" aria-hidden="true"></span></span><textarea name="reason" required minlength="5" maxlength="500" rows="2" autofocus></textarea></label>
            <%- include('reauth') %>
            <div class="confirm-actions">
              <button type="button" class="secondary" data-dialog-close>Batal</button>
              <button name="action" value="<%= business.published?'hide':'publish' %>" class="<%= business.published?'danger':'' %>"><%= business.published?'Ya, sembunyikan':'Ya, publikasikan' %></button>
            </div>
          </form>
        </dialog>
      <% } %>
      <% if (business.operator) { %>
        <dialog class="confirm-dialog form-dialog" id="revoke-dialog" aria-labelledby="revoke-title">
          <form class="confirm-panel" action="/api/v1/management/shops/<%= business.id %>" method="post">
            <span class="confirm-icon" aria-hidden="true"><%- include('icon',{name:'lock'}) %></span>
            <h2 id="revoke-title">Cabut akses <%= business.operator %>?</h2>
            <p>Akun penjahit tidak bisa lagi masuk ke ruang usaha ini, dan profil disembunyikan dari marketplace.</p>
            <input type="hidden" name="revision" value="<%= business.moderation_revision %>">
            <label><span class="field-label">Alasan pencabutan<span class="req" aria-hidden="true"></span></span><textarea name="reason" required minlength="5" maxlength="500" rows="2" autofocus></textarea></label>
            <%- include('reauth') %>
            <div class="confirm-actions">
              <button type="button" class="secondary" data-dialog-close>Batal</button>
              <button name="action" value="revoke" class="danger">Ya, cabut akses</button>
            </div>
          </form>
        </dialog>
      <% } %>
    </section><% } %>
  </div>
</section>
<%- include('footer') %>
