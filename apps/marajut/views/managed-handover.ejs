<% const path = '/api/v1/management/orders/'+order.id+'/transitions'; %>
<section class="card workflow-card" id="serah-terima" tabindex="-1">
  <div class="section-caption"><div><h2>Serah terima</h2><p class="muted"><%= handoverLabels[order.handover] %></p></div></div>
  <p class="preserve"><%= order.terms %></p>
  <% if (order.shipped_at) { %>
    <dl class="terms"><div><dt>Dikirim</dt><dd><%= dateTime(order.shipped_at) %></dd></div></dl>
    <p class="message-box preserve"><%= order.shipping_note %></p>
  <% } %>
  <% if (order.status==='READY' && isCustomer && order.handover==='delivery' && !order.shipped_at) { %>
    <p><a href="/akun/profil">Periksa alamat pengiriman di profil</a></p>
  <% } %>
  <% if (order.status==='READY' && user.manager) { %>
    <form class="stack" method="post" action="<%= path %>">
      <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="revision" value="<%= order.revision %>">
      <% if (order.handover==='delivery' && !order.shipped_at) { %>
        <div><strong>Alamat di profil pelanggan</strong>
          <p class="preserve"><%= contacts.address || 'Alamat belum diisi. Konfirmasi alamat dengan pelanggan.' %></p></div>
        <label><span class="field-label">Kurir, nomor resi, atau catatan pengantaran<span class="req" aria-hidden="true"></span></span><textarea name="detail" maxlength="500" rows="2" required></textarea></label>
        <button name="action" value="ship" data-confirm="Pelanggan akan melihat bahwa pesanan sedang dikirim." data-confirm-title="Catat sudah dikirim?" data-confirm-action="Ya, catat" data-confirm-icon="bag">Catat sudah dikirim</button>
      <% } else { %>
        <p class="form-help muted"><%= order.handover==='delivery' ? 'Selesaikan setelah pelanggan menerima kiriman.' : 'Selesaikan setelah pelanggan mengambil pakaian.' %></p>
        <button name="action" value="complete" data-confirm="Pesanan ditandai selesai dan dipindahkan ke riwayat." data-confirm-title="Selesaikan pesanan?" data-confirm-action="Ya, selesaikan" data-confirm-icon="check">Selesaikan pesanan</button>
      <% } %>
    </form>
  <% } %>
</section>
