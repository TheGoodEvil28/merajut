<% if (order.review_pending) { %><p class="notice">Pengelola sedang meninjau permohonan pembatalan.</p><% } else if (legacyProvider && ['IN_PROGRESS','READY'].includes(order.status)) { %>
<details class="card"><summary>Ajukan pembatalan kepada pengelola</summary>
<form class="stack" method="post" action="/api/v1/provider/orders/<%= order.id %>/review">
<input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="revision" value="<%= order.revision %>">
<label><span class="field-label">Alasan pembatalan<span class="req" aria-hidden="true"></span></span><textarea name="reason" minlength="5" maxlength="500" required></textarea></label>
<button class="secondary" data-confirm="Admin akan meninjau permintaan pembatalan pesanan ini." data-confirm-title="Ajukan peninjauan pembatalan?" data-confirm-action="Ya, ajukan" data-confirm-icon="cancel">Ajukan peninjauan</button></form></details><% } %>
<% if (['READY','COMPLETED'].includes(order.status) || order.cash_receipts?.length) {
  const current = order.cash_receipts?.find(r => !r.voidAt); %>
<section class="card" id="tunai"><h2>Catatan tunai</h2>
<% if (!current) { %><p>Belum ada penerimaan tunai yang tercatat.</p><% } else { %><p><strong><%= money(current.amount) %></strong> diterima tunai menurut catatan <%= current.actor %> · <%= dateTime(current.at) %>.</p><% } %>
<% if (legacyProvider && ['READY','COMPLETED'].includes(order.status)) { %>
<details><summary><%= current?'Koreksi catatan tunai':'Catat penerimaan tunai' %></summary>
<form class="stack" method="post" action="/api/v1/provider/orders/<%= order.id %>/cash">
<input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="revision" value="<%= order.cash_revision %>">
<% if (current) { %><label><span class="field-label">Alasan koreksi<span class="req" aria-hidden="true"></span></span><textarea name="reason" minlength="5" maxlength="500" required></textarea></label><button class="secondary" name="action" value="void" data-confirm="Catatan penerimaan dikoreksi dan pesanan kembali belum lunas." data-confirm-title="Batalkan catatan tunai?" data-confirm-action="Ya, batalkan" data-confirm-icon="cancel" data-confirm-tone="danger">Batalkan catatan tunai</button>
<% } else { %><label class="check-label"><input type="checkbox" name="confirmed" value="yes" required>Saya sudah menerima uang tunai sebesar <%= money(order.amount) %>.<span class="req" aria-hidden="true"></span></label><button name="action" value="record" data-confirm="Pembayaran tunai dicatat sebagai diterima untuk pesanan ini." data-confirm-title="Catat penerimaan tunai?" data-confirm-action="Ya, catat" data-confirm-icon="check">Simpan penerimaan</button><% } %>
</form></details><% } %>
</section><% } %>
