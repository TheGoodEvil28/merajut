<%- include('header') %>
<% const latest = quotes[0];
const isCustomer = user.role==='customer';
const staffBase = '/api/v1/management';
const editQuote = user.manager && open && inquiry.dispatch_state==='AVAILABLE' &&
  ['NEW','UNDER_REVIEW','QUOTED','EXPIRED'].includes(inquiry.status);
const orderPath = '/api/v1/management/orders/'+order?.id+'/transitions';
const progressAction = order?.tailor_blocked ? null : { CONFIRMED:['start','Mulai pengerjaan'], IN_PROGRESS:['ready','Tandai jahitan siap'] }[order?.status];
const liveOrder = isCustomer && ['CONFIRMED','IN_PROGRESS','READY'].includes(order?.status);
const tailorUpdateKinds = ['TAILOR_START_PLANNED','TAILOR_PROGRESS','TAILOR_FITTING_ACK','TAILOR_RESUMED'];
const latestWorkEvent = liveOrder && !order.tailor_blocked && events.findLast(item =>
  tailorUpdateKinds.includes(item.kind) || ['ORDER_UPDATED','ORDER_SHIPPED'].includes(item.kind) || item.kind.startsWith('FITTING_'));
const fittingOutstanding = Boolean(order?.fitting_state && order.fitting_state!=='DONE');
const hasPayment = Boolean(order && order.status!=='CANCELLED');
const showHandover = order?.status==='COMPLETED' || (order?.status==='READY' && order.payment?.state==='PAID');
const clarification = events.findLast(item=>item.kind==='INQUIRY_UPDATED' && item.detail &&
  (item.new_status==='NEEDS_DETAILS' || (item.new_status==='UNDER_REVIEW' && ['NEEDS_DETAILS','QUOTED'].includes(item.old_status))));
const showClarification = open && clarification &&
  (['NEEDS_DETAILS','DRAFT_QUOTE'].includes(journey.key) ||
    (user.manager && ['NEW','CONTACTED','REJECTED','EXPIRED'].includes(journey.key)));
const shownEvents = events.filter(item=>user.manager || item.kind!=='GROUP_POSTED').toReversed();
const dispatchFirst = open && ['NEW','CONTACTED','UNAVAILABLE'].includes(journey.key);
const awaitingReplyDecision = user.manager && open && ['NEW','CONTACTED'].includes(journey.key) && whatsapp?.replies.length > 0;
const showWhatsAppFollowups = whatsapp && whatsapp.mode!=='disabled' && whatsapp.followups.some(preview=>preview.channel==='partner');
%>
<section class="section workflow-page" <% if (liveOrder) { %>data-order-version="<%= events.at(-1)?.sequence ?? '0' %>" data-order-updates="/api/v1/inquiries/<%= inquiry.id %>/order-version"<% } %>>
  <a class="back" href="<%= user.manager?'/pengelola':'/workspace' %>"><%= user.manager?'Pesanan':'Pesanan Saya' %></a>
  <header class="page-heading workflow-heading">
    <div>
      <p class="order-ref">#<%= orderReference(inquiry.id) %> <span>·</span> <%= inquiry.business %></p>
      <h1><%= inquiry.service %></h1>
    </div>
    <span class="status" data-tone="<%= journey.tone %>"><%= journey.label %></span>
  </header>
  <% if (journey.step!==undefined) { %>
    <ol class="journey" aria-label="Tahap pesanan">
      <% for (const [index,label] of milestones.entries()) { %>
        <li <%= index===journey.step?'aria-current=step':'' %> class="<%= index<journey.step?'done':'' %>">
          <span class="journey-mark" aria-hidden="true"><% if (index<journey.step) { %><%- include('icon',{name:'check'}) %><% } %></span>
          <span><%= label %><% if (index<journey.step) { %><span class="sr-only"> selesai</span><% } %></span>
        </li>
      <% } %>
    </ol>
  <% } %>
  <% if (formError) { %><p class="notice error-message" role="alert"><%= formError %></p>
  <% } else if (notice) { %><p class="save-feedback" role="status"><%- include('icon',{name:'check'}) %> <%= notice %></p><% } %>
  <% if (liveOrder) { %><p class="notice" data-order-update-pending role="status" hidden>Ada pembaruan pesanan. Muat ulang halaman setelah selesai mengisi.</p><% } %>
  <div class="workflow-layout">
    <div class="stack">
      <section class="next-action <%= isCustomer?'customer-action':'' %>" aria-labelledby="next-title">
        <div>
          <h2 id="next-title"><%= awaitingReplyDecision ? 'Balasan WhatsApp diterima' : journey.title %></h2>
          <p><%= awaitingReplyDecision ? (quoteReply?.declined ? 'Mitra memilih menolak permintaan. Tinjau balasannya dan catat jika mitra berhalangan.'
            : quoteReply?.draft ? 'Mitra sudah mengirim penawaran. Catat Penjahit bersedia untuk membuka draft penawaran yang sudah terisi.'
            : 'Tinjau jawaban penjahit dan catat kesediaannya untuk melanjutkan ke penawaran.')
            : journey.key==='PENDING' && isCustomer && order.payment.mode==='demo'
            ? 'Admin akan memeriksa transaksi simulasi. Status akan berubah setelah admin mencatat hasilnya.' : journey.description %></p>
        </div>
        <% if (awaitingReplyDecision) { %>
          <a class="button" href="#balasan-whatsapp">Tinjau balasan <%- include('icon',{name:'arrow'}) %></a>
        <% } else if (journey.href) { %>
          <a class="button" href="<%= journey.href %>"><%= journey.action %> <%- include('icon',{name:'arrow'}) %></a>
        <% } %>
      </section>
      <% if (tailorUpdateKinds.includes(latestWorkEvent?.kind)) { %>
        <div class="card workflow-card" aria-label="Kabar terbaru dari mitra">
          <strong><%= eventLabel(latestWorkEvent.kind) %></strong>
          <% if (latestWorkEvent.detail) { %><p><%= latestWorkEvent.detail %></p><% } %>
          <p class="muted"><%= dateTime(latestWorkEvent.created_at) %></p>
        </div>
      <% } %>
      <% if (journey.key==='TAILOR_BLOCKED' && user.manager) { %>
        <form method="post" action="<%= orderPath %>">
          <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="revision" value="<%= order.revision %>">
          <button name="action" value="resume">Catat kendala selesai</button>
        </form>
      <% } %>
      <% if (showWhatsAppFollowups) { %><a class="button secondary" href="#tindak-lanjut-whatsapp">Tindak lanjut WhatsApp mitra</a><% } %>
      <% if (showClarification) { %>
        <section class="card workflow-card" id="klarifikasi" tabindex="-1">
          <h2><%= journey.key==='NEEDS_DETAILS' ? 'Pertanyaan admin'
            : isCustomer ? 'Pesan yang Anda kirim'
            : clarification.old_status==='QUOTED' ? 'Permintaan penyesuaian' : 'Detail dari pelanggan' %></h2>
          <p class="message-box preserve"><%= clarification.detail %></p>
          <% if (journey.key==='NEEDS_DETAILS' && isCustomer) { %>
            <form class="stack" method="post" action="/api/v1/inquiries/<%= inquiry.id %>/actions">
              <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="revision" value="<%= inquiry.revision %>">
              <label><span class="field-label">Jawaban untuk admin<span class="req" aria-hidden="true"></span></span><textarea name="detail" maxlength="500" rows="3" required></textarea></label>
              <button name="action" value="respond">Kirim jawaban</button>
            </form>
          <% } %>
        </section>
      <% } %>
      <% if (user.manager && dispatchFirst) { %><%- include('managed-dispatch',{awaitingReplyDecision}) %><% } %>
      <% if (canChoose) { %><%- include('managed-reassign') %><% } %>
      <% if (latest && !order) { %><%- include('managed-quote',{latest,isCustomer}) %><% } %>
      <% if (editQuote && journey.key==='QUOTED' && !quoteError) { %>
        <details class="card workflow-options"><summary>Revisi penawaran</summary><%- include('quote-editor',{latest,staffBase}) %></details>
      <% } else if (editQuote) { %><%- include('quote-editor',{latest,staffBase}) %><% } %>
      <% if (order?.fitting_state) { %><%- include('managed-fitting',{isCustomer}) %><% } %>
      <% if (user.manager && progressAction) { %>
        <section class="card workflow-card" id="pengerjaan" tabindex="-1">
          <h2>Pengerjaan</h2>
          <p><%= progressAction[0]==='start' ? 'Catat setelah penjahit mulai mengerjakan pesanan.'
            : fittingOutstanding ? 'Catat bahwa fitting sudah selesai sebelum membuka pembayaran.'
            : 'Tandai jahitan siap agar pelanggan bisa membayar.' %></p>
          <% if (progressAction[0]==='start' || !fittingOutstanding) { %>
            <form method="post" action="<%= orderPath %>">
              <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="revision" value="<%= order.revision %>">
              <button name="action" value="<%= progressAction[0] %>" data-confirm="Status pesanan berubah dan pelanggan akan melihat pembaruan ini." data-confirm-title="<%= progressAction[1] %>?" data-confirm-action="Ya, lanjutkan" data-confirm-icon="check"><%= progressAction[1] %></button>
            </form>
          <% } %>
        </section>
      <% } %>
      <% if (showHandover) { %><%- include('managed-handover',{isCustomer}) %><% } %>
      <% if (hasPayment) { %><%- include('order-payment') %><% } %>
      <% if (order?.status === 'COMPLETED') { %><%- include('service-review') %><% } %>
      <% if (user.manager && !dispatchFirst && (open || progressAction || order?.status==='READY' || showWhatsAppFollowups || whatsapp?.history.length || whatsapp?.replies.length)) { %><%- include('managed-dispatch',{awaitingReplyDecision}) %><% } %>
      <% if (isCustomer) { %><%# customer cancel card lives in the right column %>
      <% } else if (open || (user.manager && order?.status==='CONFIRMED')) { %>
        <% const closeLabel = user.manager && open ? 'Tutup permintaan' : open ? 'Batalkan permintaan' : 'Batalkan pesanan';
           const canClarify = user.manager && open && ['NEW','UNDER_REVIEW'].includes(inquiry.status); %>
        <section class="card workflow-card action-card" aria-labelledby="other-actions-title">
          <div class="section-caption"><div><h2 id="other-actions-title">Tindakan lain</h2><p class="muted">Minta keterangan tambahan atau tutup proses ini.</p></div>
            <div class="actions">
              <% if (canClarify) { %><button type="button" class="secondary" command="show-modal" commandfor="clarify-dialog"><%- include('icon',{name:'chat'}) %>Minta detail pelanggan</button><% } %>
              <button type="button" class="secondary danger-outline" command="show-modal" commandfor="close-dialog"><%- include('icon',{name:'cancel'}) %><%= closeLabel %></button>
            </div></div>
        </section>
        <% if (canClarify) { %>
        <dialog class="confirm-dialog form-dialog" id="clarify-dialog" aria-labelledby="clarify-title">
          <form class="confirm-panel" action="/api/v1/inquiries/<%= inquiry.id %>/actions" method="post">
            <span class="confirm-icon" aria-hidden="true"><%- include('icon',{name:'chat'}) %></span>
            <h2 id="clarify-title">Minta detail pelanggan</h2>
            <p>Pelanggan akan diminta melengkapi permintaan sebelum koordinasi dilanjutkan.</p>
            <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="revision" value="<%= inquiry.revision %>">
            <label><span class="field-label">Pertanyaan untuk pelanggan<span class="req" aria-hidden="true"></span></span><textarea name="detail" maxlength="500" rows="3" required autofocus></textarea></label>
            <div class="confirm-actions"><button type="button" class="secondary" data-dialog-close>Batal</button><button name="action" value="clarify">Kirim pertanyaan</button></div>
          </form>
        </dialog>
        <% } %>
        <dialog class="confirm-dialog form-dialog" id="close-dialog" aria-labelledby="close-title">
          <form class="confirm-panel" method="post" action="<%= open?'/api/v1/inquiries/'+inquiry.id+'/actions':orderPath %>">
            <span class="confirm-icon" aria-hidden="true"><%- include('icon',{name:'cancel'}) %></span>
            <h2 id="close-title"><%= closeLabel %>?</h2>
            <p>Proses ditutup untuk pelanggan dan penjahit. Tindakan ini tidak bisa diurungkan.</p>
            <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="revision" value="<%= open?inquiry.revision:order.revision %>">
            <label><span class="field-label">Alasan <%= user.manager && open?'penutupan':'pembatalan' %><span class="req" aria-hidden="true"></span></span><textarea name="detail" maxlength="500" rows="3" required autofocus></textarea></label>
            <div class="confirm-actions"><button type="button" class="secondary" data-dialog-close>Batal</button><button class="danger" name="action" value="<%= user.manager && open?'decline':'cancel' %>">Ya, <%= closeLabel.toLowerCase() %></button></div>
          </form>
        </dialog>
      <% } %>
      <% if (isCustomer) { %>
      <%- include('inquiry-photos') %>
      <section class="card timeline history-card" aria-labelledby="history-title"><h2 id="history-title">Riwayat aktivitas</h2>
        <ol><% for (const item of shownEvents) { %><li>
          <strong><%= eventLabel(item.kind) %></strong>
          <time datetime="<%= item.created_at.toISOString() %>"><%= dateTime(item.created_at) %></time>
          <% if (item.detail) { %><p class="preserve"><%= item.detail %></p><% } %>
        </li><% } %></ol>
      </section>
      <% } %>
    </div>
    <div class="stack">
      <section class="card order-summary" aria-labelledby="summary-title">
        <h2 id="summary-title"><%= order?'Detail pesanan':'Ringkasan permintaan' %></h2>
        <div class="price-highlight">
          <span><%= order?'Harga disepakati':'Perkiraan awal' %></span>
          <strong><%= order ? money(order.amount) : inquiry.estimate ? money(inquiry.estimate) : 'Sesuai penawaran' %></strong>
        </div>
        <% if (!order) { %><p class="muted">Harga akhir mengikuti penawaran yang Anda setujui.</p><% } %>
        <div class="summary-detail" id="detail" tabindex="-1">
          <h3>Detail permintaan</h3><p class="preserve"><%= inquiry.description %></p>
          <% if (inquiry.fit_notes) { %><p class="preserve"><strong>Catatan ukuran</strong><br><%= inquiry.fit_notes %></p><% } %>
        </div>
        <dl class="summary-list">
          <div><dt>Penjahit</dt><dd><% if (inquiry.published) { %><a href="/penjahit/<%= inquiry.slug %>"><%= inquiry.business %></a><% } else { %><%= inquiry.business %><% } %></dd></div>
          <div><dt>Jumlah pakaian</dt><dd><%= inquiry.quantity ?? 1 %></dd></div>
          <% if (order || inquiry.desired_date) { %><div><dt><%= order?'Perkiraan selesai':'Target pelanggan' %></dt>
            <dd><%= localDate(order?.eta ?? inquiry.desired_date) %></dd></div><% } %>
          <% if (order?.handover || inquiry.requested_handover) { %><div><dt><%= order?'Serah terima':'Pilihan serah terima' %></dt>
            <dd><%= handoverLabels[order?.handover ?? inquiry.requested_handover] %></dd></div><% } %>
          <% if (!order && inquiry.fitting_requested!==null) { %><div><dt>Fitting</dt><dd><%= inquiry.fitting_requested?'Diminta pelanggan':'Tidak diminta' %></dd></div><% } %>
        </dl>
        <% if (order) { %><%- include('quote-breakdown',{items:order.line_items}) %>
          <% if (!showHandover) { %><p class="preserve"><%= order.terms %></p><% } %><% } %>
        <% if (inquiry.previous_inquiry_id) { %><p><a href="/requests/<%= inquiry.previous_inquiry_id %>">Riwayat penjahit sebelumnya</a></p><% } %>
        <% if (user.manager) { %><div class="contact-summary">
          <span class="muted">Pelanggan</span><strong><%= contacts.display_name %></strong>
          <% if (contacts.phone) { %><a target="_blank" rel="noreferrer" href="https://wa.me/<%= contacts.phone %>">WhatsApp pelanggan <span class="sr-only">(tab baru)</span></a><% } %>
          <% if (contacts.address && (order?.handover ?? inquiry.requested_handover)==='delivery') { %>
            <details><summary>Alamat di profil</summary><p class="preserve"><%= contacts.address %></p></details>
          <% } %>
        </div><% } %>
      </section>
      <% if (isCustomer && open) { %>
        <section class="card cancel-card" aria-labelledby="cancel-title"><div class="section-caption"><div><h2 id="cancel-title">Tidak jadi menjahit?</h2><p class="muted">Anda bisa membatalkan selama permintaan belum menjadi pesanan.</p></div>
          <button type="button" class="secondary danger-outline" command="show-modal" commandfor="cancel-dialog"><%- include('icon',{name:'cancel'}) %>Batalkan permintaan</button></div></section>
        <dialog class="confirm-dialog form-dialog" id="cancel-dialog" aria-labelledby="cancel-dialog-title">
          <form class="confirm-panel" method="post" action="/api/v1/inquiries/<%= inquiry.id %>/actions">
            <span class="confirm-icon" aria-hidden="true"><%- include('icon',{name:'cancel'}) %></span>
            <h2 id="cancel-dialog-title">Batalkan permintaan?</h2>
            <p>Permintaan ditutup dan tidak akan diproses. Tindakan ini tidak bisa dibatalkan.</p>
            <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="revision" value="<%= inquiry.revision %>">
            <label><span class="field-label">Alasan pembatalan<span class="req" aria-hidden="true"></span></span><textarea name="detail" maxlength="500" rows="3" required autofocus></textarea></label>
            <div class="confirm-actions"><button type="button" class="secondary" data-dialog-close>Batal</button><button class="danger" name="action" value="cancel">Ya, batalkan</button></div>
          </form>
        </dialog>
      <% } %>
      <% if (!isCustomer) { %><%- include('inquiry-photos') %><% } %>
      <% if (quotes.length>1) { %>
        <details class="card workflow-options"><summary>Versi penawaran sebelumnya</summary>
          <ul class="quote-history"><% for (const quote of quotes.slice(1)) { %><li>
            <strong>Versi <%= quote.version %> · <%= money(quote.amount) %> · <%= statusLabel(quote.status) %></strong>
            <%- include('quote-breakdown',{items:quote.line_items}) %>
          </li><% } %></ul>
        </details>
      <% } %>
      <% if (conversation && intakeEnabled) { %><p><a href="/workspace/intake/<%= conversation.id %>">Buka percakapan simulasi</a></p><% } %>
      <% if (!isCustomer) { %><section class="card timeline history-card" aria-labelledby="history-title"><h2 id="history-title">Riwayat aktivitas</h2>
        <ol><% for (const item of shownEvents) { %><li>
          <strong><%= eventLabel(item.kind) %></strong>
          <time datetime="<%= item.created_at.toISOString() %>"><%= dateTime(item.created_at) %></time>
          <% if (item.detail) { %><p class="preserve"><%= item.detail %></p><% } %>
        </li><% } %></ol>
      </section><% } %>
    </div>
  </div>
</section>
<%- include('footer') %>
