<form class="stack" method="post" action="<%= permissionPath %>">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <input type="hidden" name="version" value="<%= permission?.version ?? 0 %>">
  <label>Referensi persetujuan atau alasan pencabutan<textarea name="evidence" required minlength="5" maxlength="500" rows="2"></textarea></label>
  <label class="check-label"><input type="checkbox" name="confirmed" value="yes"<% if (approved) { %> checked<% } %>> <%= consentLabel %></label>
  <% if (partnerPermission) { %>
    <label>Identitas alternatif terverifikasi (opsional)<input name="senderAlias" maxlength="100" placeholder="123456789@lid" value="<%= permission?.sender_alias || '' %>"></label>
    <label class="check-label"><input type="checkbox" name="groupMember" value="yes"<% if (groupMember) { %> checked<% } %><% if (!groupApproved) { %> disabled<% } %>> Keanggotaan di grup pengiriman sudah diperiksa</label>
    <% if (!groupApproved) { %><p class="muted form-help">Catat persetujuan grup penjahit di Operasional sebelum menyimpan keanggotaan.</p><% } %>
  <% } %>
  <div class="actions">
    <button name="action" value="grant">Simpan persetujuan</button>
    <% if (approved) { %><button class="secondary" name="action" value="revoke">Cabut persetujuan</button><% } %>
  </div>
</form>
