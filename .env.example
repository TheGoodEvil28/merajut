# Copy to .env and supply independently generated local secrets.
POSTGRES_USER=merajut
POSTGRES_DB=merajut
POSTGRES_PASSWORD=
DEMO_PASSWORD=
DISPATCH_WHATSAPP_MODE=disabled
APP_PORT=3100
MAIL_PORT=3101
MESSAGING_MODE=simulated
# Local demo by default. Use sandbox or live with a matching Midtrans server key.
PAYMENT_MODE=demo
MIDTRANS_SERVER_KEY=
PLATFORM_FEE_BPS=500
ADMIN_WHATSAPP=
# Optional independent secret for signed fixture webhooks. Browser simulator needs no key.
SIMULATION_WEBHOOK_SECRET=
