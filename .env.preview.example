# Copy to .env.preview and set secrets for the dedicated synthetic preview.
POSTGRES_USER=merajut
POSTGRES_DB=merajut
POSTGRES_PASSWORD=
DEMO_PASSWORD=

PREVIEW_IMAGE=merajut-preview:local
PREVIEW_APP_HOST=localhost
PREVIEW_MAIL_HOST=127.0.0.1
PREVIEW_BIND_ADDRESS=127.0.0.1
PREVIEW_HTTP_PORT=3171
PREVIEW_HTTPS_PORT=3170
PREVIEW_TESTERS_FILE=./.preview-secrets/testers
PREVIEW_QA_FILE=./.preview-secrets/qa
# Optional canonical app URL when the preview sits behind a tunnel.
PREVIEW_PUBLIC_APP_ORIGIN=
# Optional WhatsApp contact for partner registration during the private pilot.
PREVIEW_ADMIN_WHATSAPP=

DISPATCH_WHATSAPP_MODE=disabled
OPENWA_SESSION_ID=
OPENWA_GROUP_CHAT_ID=
OPENWA_GROUP_LABEL=
OPENWA_WEBHOOK_SECRET=
# Only the dispatch worker receives this scoped operator key in the OpenWA overlay.
OPENWA_API_KEY=
